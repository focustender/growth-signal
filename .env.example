# Copy to .env and fill in real values. Never commit .env itself.

# Salesforce Developer Edition (developer.salesforce.com)
SALESFORCE_USERNAME=
SALESFORCE_PASSWORD=
SALESFORCE_SECURITY_TOKEN=
SALESFORCE_DOMAIN=login

# HubSpot — only needed as a fallback if the Claude Code HubSpot MCP
# read tools aren't available in your environment. Create under
# HubSpot Settings > Integrations > Private Apps, with CRM read scopes.
HUBSPOT_PRIVATE_APP_TOKEN=
