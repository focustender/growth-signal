# Copy to .env and fill in real values. Never commit .env itself.

# Salesforce Developer Edition (developer.salesforce.com)
# OAuth 2.0 JWT Bearer flow via a Connected App (Setup > App Manager > New
# Connected App > Enable OAuth Settings > Use digital signatures > upload
# the public cert from generate_salesforce_jwt_keypair.sh). Neither plain
# SOAP login() nor the OAuth username-password flow work on a fresh org --
# both are blocked by Salesforce platform defaults -- so this is the path
# that actually works, not a fallback.
SALESFORCE_USERNAME=
SALESFORCE_CONSUMER_KEY=
SALESFORCE_DOMAIN=login
# Optional: override the private key file location (default:
# salesforce_jwt.key next to salesforce_client.py, gitignored).
# SALESFORCE_JWT_PRIVATE_KEY_FILE=

# Unused by the current JWT Bearer flow, kept for reference / in case a
# future environment needs to fall back to a different auth flow.
SALESFORCE_PASSWORD=
SALESFORCE_SECURITY_TOKEN=
SALESFORCE_CONSUMER_SECRET=

# HubSpot — only needed as a fallback if the Claude Code HubSpot MCP
# read tools aren't available in your environment. Create under
# HubSpot Settings > Integrations > Private Apps, with CRM read scopes.
HUBSPOT_PRIVATE_APP_TOKEN=
